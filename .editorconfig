root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{R,r}]
indent_size = 2
indent_style = space

[*.{Rmd,rmd,qmd}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{json,js,ts}]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{sh,bash}]
indent_size = 2
indent_style = space
end_of_line = lf

[Makefile]
indent_style = tab

[*.{bat,ps1}]
end_of_line = crlf

[*.ipynb]
indent_size = 1
charset = utf-8
